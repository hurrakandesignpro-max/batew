# Copie ce fichier en .env.local pour tester en local :  cp .env.example .env.local

# Mot de passe de la page /admin (OBLIGATOIRE, sinon l'admin est désactivée)
ADMIN_PASSWORD=RED24!

# Optionnel : phrase secrète utilisée pour signer le cookie de connexion.
# Si absente, le mot de passe sert de base.
# ADMIN_SECRET=unbateauestalamer

# Stockage Redis (Upstash). Sur Vercel, ces variables sont ajoutées
# automatiquement quand tu connectes une base Upstash Redis au projet.
# En local, sans ces variables, les données sont gardées dans le dossier .data/
#
# Selon la version de l'intégration Vercel/Upstash, le préfixe peut varier :
#   - Intégration standard (1 seule base)  → KV_REST_API_URL / KV_REST_API_TOKEN
#   - Intégration nommée (plusieurs bases) → STORAGE_KV_REST_API_URL / STORAGE_KV_REST_API_TOKEN
# Les deux formes sont acceptées, plus UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# STORAGE_KV_REST_API_URL=
# STORAGE_KV_REST_API_TOKEN=
